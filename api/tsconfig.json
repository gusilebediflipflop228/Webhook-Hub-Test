{
  "compilerOptions": {
    "target": "ES2022", // версия
    "module": "commonjs",
    "outDir": "./dist", // папка для скомпилированных файлов
    "rootDir": "./src", // папка с исходными файлами
    "strict": true, // типизация(ошибки)
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*"]
}